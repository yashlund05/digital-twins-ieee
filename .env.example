# =============================================================================
# .env.example — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# =============================================================================

# --- Pecan Street Dataport ---
# Obtain credentials at: https://dataport.pecanstreet.org
PECAN_STREET_USERNAME=your_pecan_street_username_here
PECAN_STREET_PASSWORD=your_pecan_street_password_here
PECAN_STREET_API_KEY=your_api_key_here

# --- Data Paths ---
# Override default data directory (default: ./data)
# DATA_ROOT=/path/to/your/data

# --- Experiment Paths ---
# Override default experiment directory (default: ./experiments)
# EXPERIMENT_ROOT=/path/to/your/experiments

# --- OpenDSS ---
# Path to OpenDSS installation if not using pip package
# OPENDSS_PATH=/path/to/OpenDSS

# --- Hardware ---
# Set CUDA device if using GPU-accelerated training
# CUDA_VISIBLE_DEVICES=0

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Project ---
# Git repository URL (used in manifests)
GITHUB_REPO=https://github.com/yashlund05/digital-twins-ieee

# --- MLflow (optional, if experiment tracking is enabled) ---
# MLFLOW_TRACKING_URI=http://localhost:5000
